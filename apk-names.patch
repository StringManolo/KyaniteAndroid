diff --git a/.github/workflows/android.yml b/.github/workflows/android.yml
--- a/.github/workflows/android.yml	2026-11-22 15:02:02.123286052 +0000
+++ b/.github/workflows/android.yml	2026-11-23 09:38:40.034049128 +0000
@@ -24,14 +24,14 @@
           - arch: aarch64
             abi: arm64-v8a
             with_vm: 'true'
-            # same name as before the arm32 port: existing .../releases/latest/download/app-release.apk links keep working,
-            # and it contains "release" so old in-app updaters still pick it (see Updater.kt)
-            release_apk: app-release.apk
+            # names the website links to (.../releases/latest/download/Kyanite.apk)
+            release_apk: Kyanite.apk
             debug_apk: KyaniteAndroid-debug-arm64-v8a.apk
           - arch: armv7
             abi: armeabi-v7a
             with_vm: 'false'
-            release_apk: KyaniteAndroid-armeabi-v7a.apk
+            # the 32-bit APK must contain "v7" (Updater.kt tells the two apart by that)
+            release_apk: kyanite_v7.apk
             debug_apk: KyaniteAndroid-debug-armeabi-v7a.apk
 
     steps:
diff --git a/app/src/main/java/io/github/stringmanolo/KyaniteAndroid/Updater.kt b/app/src/main/java/io/github/stringmanolo/KyaniteAndroid/Updater.kt
--- a/app/src/main/java/io/github/stringmanolo/KyaniteAndroid/Updater.kt	2026-11-22 14:42:33.287898473 +0000
+++ b/app/src/main/java/io/github/stringmanolo/KyaniteAndroid/Updater.kt	2026-11-23 09:38:40.034214521 +0000
@@ -35,13 +35,11 @@
         var url: String? = null
         var name: String? = null
         if (assets != null) {
-            val tags = listOf("arm64-v8a", "armeabi-v7a")
             val apks = (0 until assets.length()).map { assets.getJSONObject(it) }
                 .filter { it.optString("name").endsWith(".apk") }
-            // The APK built for the ABI this process runs as; releases from before the arm32 port carry a single,
-            // untagged APK (arm64), which is only valid for 64-bit.
-            val pick = apks.firstOrNull { it.optString("name").contains(Abi.apk) }
-                ?: if (Abi.is64) apks.firstOrNull { n -> tags.none { n.optString("name").contains(it) } } else null
+            // The 32-bit APK is the one whose name contains "v7" (kyanite_v7.apk); any other APK is the 64-bit one
+            // (Kyanite.apk), which is also the only kind that releases from before the arm32 port carry.
+            val pick = apks.firstOrNull { it.optString("name").contains("v7", true) == !Abi.is64 }
             if (pick != null) {
                 url = pick.optString("browser_download_url"); name = pick.optString("name")
             }
